# askai backend configuration template
# Copy to `.env` and adjust values for your environment:
#   cp .env.example .env

# JWT
JWT_SECRET=change-this-super-secret-key-please-32bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend / debug
FRONTEND_URL=http://localhost:5173
DEBUG=true
SMS_MOCK=true

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=20971520

# Skill sandbox (auto / docker / local)
SKILL_SANDBOX=auto
SKILL_RUNNER_IMAGE=askai-skill-runner
SKILL_DATA_VOLUME=app_data
SKILL_DATA_MOUNT=/app/data
SKILL_TIMEOUT=60
SKILL_CPUS=1
SKILL_MEMORY=512m
SKILL_PIDS_LIMIT=64
