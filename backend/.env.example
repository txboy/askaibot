# askaibot backend configuration template
# Copy to `.env` and adjust values for your environment:
#   cp .env.example .env

# JWT
JWT_SECRET=change-this-super-secret-key-please-32bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend / debug
FRONTEND_URL=http://localhost:5173
DEBUG=true
SMS_MOCK=true

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=20971520

# Database config file (SQLite default; admin can switch DB via backend)
DB_CONFIG_FILE=./data/db_config.json

# Skill sandbox (local soft-sandbox)
SKILL_TIMEOUT=60
